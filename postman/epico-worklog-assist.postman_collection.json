{
  "info": {
    "name": "Epico Worklog Assist",
    "description": "Smart Worklog Assist prototype API.\n\nAuth: every request sends the Epico JWT in the Authorization header (Bearer), via collection-level auth. Set the collection variables:\n- base_url: your local Rails server (default http://127.0.0.1:3001)\n- bearer_token: your Epico JWT (the 'eyJ...' value; no 'Bearer ' prefix)\n- project_id: a project id (for Compose)\n- draft_id: a WorklogDraft id (for Accept)\n\nTypical flow: Verify GitHub Token -> Setup repos -> Compose -> List/Accept drafts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{bearer_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:3001" },
    { "key": "bearer_token", "value": "" },
    { "key": "project_id", "value": "1" },
    { "key": "draft_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Integration Connections",
      "description": "Per-user GitHub/Shortcut connections. Token stored encrypted, never returned.",
      "item": [
        {
          "name": "Verify GitHub Token (no auth required)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"access_token\": \"ghp_replace_with_a_real_pat\"\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/integrations/github/verify",
              "host": ["{{base_url}}"], "path": ["api", "v1", "integrations", "github", "verify"]
            },
            "description": "Validates a GitHub token (no Epico auth needed) and lists its repos."
          }
        },
        {
          "name": "List Integrations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/integrations",
              "host": ["{{base_url}}"], "path": ["api", "v1", "integrations"]
            },
            "description": "Current user's connected providers (Authorization: Bearer from collection auth)."
          }
        },
        {
          "name": "Connect GitHub",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"provider\": \"github\",\n  \"access_token\": \"ghp_replace_with_a_real_pat\",\n  \"scopes\": \"repo\"\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/integrations",
              "host": ["{{base_url}}"], "path": ["api", "v1", "integrations"]
            }
          }
        },
        {
          "name": "Disconnect GitHub",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/integrations/github",
              "host": ["{{base_url}}"], "path": ["api", "v1", "integrations", "github"]
            }
          }
        }
      ]
    },
    {
      "name": "GitHub Setup",
      "item": [
        {
          "name": "Setup repos -> projects + allocations",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"access_token\": \"ghp_replace_with_a_real_pat\",\n  \"repos\": [\"owner/repo-1\", \"owner/repo-2\"]\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/github/setup",
              "host": ["{{base_url}}"], "path": ["api", "v1", "github", "setup"]
            },
            "description": "Stores the GitHub token and turns selected repos into projects the user is allocated to."
          }
        }
      ]
    },
    {
      "name": "Worklog Drafts",
      "item": [
        {
          "name": "Compose (Auto Draft from PR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"date\": \"2026-06-08\",\n  \"hours\": 8\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/projects/{{project_id}}/worklogs/compose",
              "host": ["{{base_url}}"], "path": ["api", "v1", "projects", "{{project_id}}", "worklogs", "compose"]
            },
            "description": "Composes a draft for the given date from the user's GitHub activity in this project's repos."
          }
        },
        {
          "name": "List Drafts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/worklog_drafts",
              "host": ["{{base_url}}"], "path": ["api", "v1", "worklog_drafts"]
            }
          }
        },
        {
          "name": "Accept Draft",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/worklog_drafts/{{draft_id}}/accept",
              "host": ["{{base_url}}"], "path": ["api", "v1", "worklog_drafts", "{{draft_id}}", "accept"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/up", "host": ["{{base_url}}"], "path": ["up"] }
          }
        }
      ]
    }
  ]
}
